HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s
HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s

# OpenTelemetry: actual collector endpoint is generated by tripgoctl.
OTEL_SERVICE_NAME=trip-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tripgo,deployment.environment=local
OTEL_TRACES_SAMPLER=parentbased_always_on
# Optional for traceidratio / parentbased_traceidratio; default sampling ratio is 1.
OTEL_TRACES_SAMPLER_ARG=
# Standard SDK values in milliseconds.
OTEL_EXPORTER_OTLP_TIMEOUT=2000
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_METRIC_EXPORT_TIMEOUT=2000
OTEL_BSP_SCHEDULE_DELAY=1000
