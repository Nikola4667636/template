{
  "uid": "trip-service-lab02",
  "title": "Trip Service — Lab 2",
  "tags": ["tripgo", "lab02"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Created trips (committed)", "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "green"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"},
      "targets": [{"refId": "A", "expr": "sum(tripgo_trips_created_total{exported_job=\"tripgo/trip-service\"})", "legendFormat": "created"}]
    },
    {
      "id": 2, "title": "Completed trips (committed)", "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"},
      "targets": [{"refId": "A", "expr": "sum(tripgo_trips_completed_total{exported_job=\"tripgo/trip-service\"})", "legendFormat": "completed"}]
    },
    {
      "id": 3, "title": "Active trips (PostgreSQL)", "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "orange"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"},
      "targets": [{"refId": "A", "expr": "sum(tripgo_trips_active{exported_job=\"tripgo/trip-service\"})", "legendFormat": "active"}]
    },
    {
      "id": 4, "title": "HTTP duration p95 — since process start", "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, http_route) (http_server_request_duration_seconds_bucket{exported_job=\"tripgo/trip-service\"}))", "legendFormat": "{{http_route}}"}]
    },
    {
      "id": 5, "title": "DB duration p95 — since process start", "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, db_operation_name, db_collection_name) (db_client_operation_duration_seconds_bucket{exported_job=\"tripgo/trip-service\",db_collection_name=~\"trips|trip_status_history\"}))", "legendFormat": "{{db_operation_name}} {{db_collection_name}}"}]
    },
    {
      "id": 6, "title": "Active HTTP requests", "type": "timeseries",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (http_route) (http_server_active_requests{exported_job=\"tripgo/trip-service\"})", "legendFormat": "{{http_route}}"}]
    }
  ]
}
